# We need to create dummy variables as some of the predictive models we are using today do not automatically
# add dummy columns for categorical features (this is an issue with the packages).
fittedDummyModel <- dummyVars(~., data=predictors)
dummy_predictors <- data.frame(predict(fittedDummyModel, predictors))
# Create test-train split
inTrain <- createDataPartition(diagnosis, p = .8)[[1]]
train_diagnosis <- diagnosis[inTrain]
test_diagnosis <- diagnosis[-inTrain]
train_predictors <- dummy_predictors[inTrain,]
test_predictors <- dummy_predictors[-inTrain,]
# Logistic regression model
logisticReg_inclass <- train(x=train_predictors,
y=train_diagnosis,
method = "glm",
trControl = ctrl)
logisticReg_inclass$results
logisticReg_inclass$results
