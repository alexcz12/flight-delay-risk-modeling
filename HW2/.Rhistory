naiveBayes_inclass <- train(x=train_predictors,
y=train_diagnosis,
method = "nb",
trControl = ctrl)
naiveBayes_inclass
logistic_pred <- predict(logisticReg_inclass, newdata = test_predictors)
# Logistic regression model
