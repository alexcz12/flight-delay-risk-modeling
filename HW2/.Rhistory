library(tidyverse)
library(AppliedPredictiveModeling)
library(klaR)
library(e1071)
library(caret)
library(MASS)
library(ggplot2)
library(pROC)
library(kernlab)
ctrl <- trainControl(method = "cv", number = 10,
classProbs = TRUE)
ggroc(list(
`logistic regression` = build_credit_roc(logisticReg_inclass),
`linear SVM` = build_credit_roc(svmLinearTuned_inclass),
`radial basis SVM` = build_credit_roc(svmRTuned_inclass),
`knn` = build_credit_roc(knnTune_inclass)
))
build_credit_roc <- function(model) {
probs <- predict(model, GermanCreditTest,
type = "prob")[, "Bad"]
return(roc(relevel(GermanCreditTest$Class, "Good"), probs))
}
ggroc(list(
`logistic regression` = build_credit_roc(logisticReg_inclass),
`linear SVM` = build_credit_roc(svmLinearTuned_inclass),
`radial basis SVM` = build_credit_roc(svmRTuned_inclass),
`knn` = build_credit_roc(knnTune_inclass)
))
build_credit_roc <- function(model) {
probs <- predict(model, AlzheimerDisease,
type = "prob")[, "Bad"]
return(roc(relevel(GermanCreditTest$Class, "Good"), probs))
}
ggroc(list(
`logistic regression` = build_credit_roc(logisticReg_inclass),
`linear SVM` = build_credit_roc(svmLinearTuned_inclass),
`radial basis SVM` = build_credit_roc(svmRTuned_inclass),
`knn` = build_credit_roc(knnTune_inclass)
))
