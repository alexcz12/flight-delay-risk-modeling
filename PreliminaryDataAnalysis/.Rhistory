Day.of.Week = factor(Day.of.Week,
levels = 1:7,
labels = c("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")),
Dep = as.factor(Dep),
Arr = as.factor(Arr),
cancelled = ifelse(Actual.Block.Time == 0, 1, 0)
)
cancelled <- df %>% filter(cancelled == 1)
not_cancelled <- df %>% filter(cancelled == 0)
ctrl <- trainControl(method = "cv", number = 1)
not_cancelledX <- not_cancelled %>% select(-Marketing.Airline, -Marketing.flt.num, -Operating.Airline, -Operating.flt.num, -Report_Date, -Actual.Departure.Time, -Actual.Arrival.Time, -Actual.Block.Time, -Departure.Delay, -Arrival.Delay, -Delay.Diff, -Wheels.Up, -Wheels.Down, -cancelled, -Tail.Num, -Arr, -Dep)
set.seed(100)
enetGrid <- expand.grid(lambda = seq(0.0, 0.02, length = 5),
fraction = seq(.1, 1, length = 5))
enetTune <- train(x = not_cancelledX, y = not_cancelled$Departure.Delay,
method = "enet",
tuneGrid = enetGrid,
trControl = ctrl,
preProc = c("center", "scale")
)
