longDf <- dfTrainPreproc %>% pivot_longer(
cols = names(dfDataX),
names_to = "column_name",
values_to = "value"
)
ggplot(data=longDf, aes(x=column_name, y=value)) + geom_boxplot(alpha=0.01) + ylim(0,5)
